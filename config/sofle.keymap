#define ZMK_POINTING_DEFAULT_MOVE_VAL 200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 1

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 2
#define RAISE 3
#define COLEMAK 4

/ {
    // Activate ADJUST layer by pressing raise and lower
    // conditional_layers {
    //    compatible = "zmk,conditional-layers";
    //    adjust_layer {
    //        if-layers = <LOWER RAISE>;
    //        then-layer = <ADJUST>;
    //    };
    //};

    behaviors {
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp TILDE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        bspc_del: backspace_delete {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_RSFT)>;
        };

        my_mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;

            display-name = "Mod-Tap";
        };

        my_lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;

            display-name = "Layer-Tap";
        };
    };

    combos {
        compatible = "zmk,combos";

        default_layer_combo {
            bindings = <&to 0>;
            key-positions = <16 17 18 19>;
        };

        macos_layer_combo {
            bindings = <&to 1>;
            key-positions = <28 29 30 31>;
        };

        colemak_dh_layer_combo {
            bindings = <&to 4>;
            key-positions = <40 41 44 45>;
            layers = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&gresc            &kp N1  &kp N2    &kp N3    &kp N4        &kp N5                                     &kp N6     &kp N7      &kp N8            &kp N9             &kp N0    &bspc_del
&kp TAB           &kp Q   &kp W     &kp E     &kp R         &kp T                                      &kp Y      &kp U       &kp I             &kp O              &kp P     &kp BACKSLASH
&kp LEFT_CONTROL  &kp A   &kp S     &kp D     &kp F         &kp G                                      &kp H      &my_lt 2 J  &kp K             &kp L              &kp SEMI  &kp SQT
&kp LSHFT         &kp Z   &kp X     &kp C     &kp V         &kp B      &kp C_MUTE    &kp K_PLAY_PAUSE  &kp N      &kp M       &kp COMMA         &kp DOT            &kp FSLH  &kp LCTRL
                          &kp LGUI  &kp LALT  &kp CAPSLOCK  &mo LOWER  &kp SPACE     &kp ENTER         &mo RAISE  &kp CAPS    &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        macos_layer {
            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans        &trans  &trans            &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans            &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_GUI  &trans  &trans            &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans            &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                      &kp LEFT_CONTROL  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp K_VOLUME_UP K_VOLUME_DOWN>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&kp GRAVE  &kp F1              &kp F2          &kp F3           &kp F4         &kp F5                                 &kp F6          &kp F7       &kp F8  &kp F9  &kp F10            &kp F11
&trans     &kp HOME            &kp UP_ARROW    &kp END          &kp PAGE_UP    &msc SCRL_DOWN                         &none           &none        &none   &none   &none              &kp F12
&trans     &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN  &msc SCRL_UP                           &kp KP_MINUS    &kp KP_PLUS  &none   &none   &none              &kp GRAVE
&trans     &kp LA(LEFT_ARROW)  &none           &kp LA(RIGHT)    &none          &none           &bootloader    &trans  &kp UNDERSCORE  &kp EQUAL    &none   &none   &kp LA(LS(LG(C)))  &kp PRINTSCREEN
                               &trans          &trans           &trans         &trans          &trans         &trans  &trans          &trans       &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_NEXT C_PREV>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOL_UP>;
        };

        raise_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2           &bt BT_SEL 3  &bt BT_SEL 4                        &none  &none              &none             &none         &none  &sys_reset
&none       &kt LC(LEFT_ARROW)    &kp LG(LC(LS(UP)))    &kt LC(RIGHT_ARROW)    &none         &none                               &none  &none              &none             &none         &none  &none
&none       &kp LS(LC(LG(LEFT)))  &kp LS(LC(LG(DOWN)))  &kp LS(LC(LG(RIGHT)))  &none         &none                               &none  &kp C_VOLUME_DOWN  &kp C_MUTE        &kp C_VOL_UP  &none  &none
&none       &none                 &none                 &none                  &none         &none         &none    &bootloader  &none  &kp K_PREVIOUS     &kp K_PLAY_PAUSE  &kp K_NEXT    &none  &none
                                  &none                 &none                  &none         &none         &none    &none        &none  &none              &none             &none
            >;
        };

        // extra1 { status = "reserved"; };

        colemak_dh_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&gresc            &kp N1  &kp N2    &kp N3    &kp N4        &kp N5                                     &kp N6                 &kp N7      &kp N8            &kp N9             &kp N0         &bspc_del
&kp TAB           &kp Q   &kp W     &kp F     &kp P         &kp B                                      &kp J                  &kp L       &kp U             &kp Y              &kp SEMICOLON  &kp MINUS
&kp LEFT_CONTROL  &kp A   &kp R     &kp S     &kp T         &kp G                                      &my_mt LEFT_CONTROL M  &my_lt 2 N  &kp E             &kp I              &kp O          &kp SQT
&kp LSHFT         &kp Z   &kp X     &kp C     &kp D         &kp V      &kp C_MUTE    &kp K_PLAY_PAUSE  &kp K                  &kp H       &kp COMMA         &kp DOT            &kp FSLH       &kp RIGHT_SHIFT
                          &kp LGUI  &kp LALT  &kp CAPSLOCK  &mo LOWER  &kp SPACE     &kp ENTER         &mo RAISE              &kp CAPS    &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp C_PREV C_NEXT>;
        };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
